# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API Keys. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Do NOT add the secret / service_role key. This app does not need it.

# Only used by tools/rls_check.mjs (the security test), never by the app.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=
